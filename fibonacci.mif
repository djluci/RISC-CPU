-- program memory file for testpush.a
DEPTH = 256;
WIDTH = 16;
ADDRESS_RADIX = HEX;
DATA_RADIX = BIN;
CONTENT
BEGIN
00 : 1111100000000000; -- MOVE 0 RA   (Move 0 to Register RA)
01 : 1111100000001001; -- MOVE 1 RB   (Move 1 to Register RB)
02 : 1111100001010100; -- MOVE 10 RE  (Move 10 to Register RE)
03 : 1111100000001011; -- MOVE 1 RD   (Move 1 to Register RD)
04 : 1000000001000010; -- ADD RA RB RC  (Add RA and RB and store the Results in RC)
05 : 1111000100000000; -- MOVE RB RA    (Move RB's content to Register RA)
06 : 1111001000000001; -- MOVE RC RB    (Move RC's content to Register RB)
07 : 1001100011000100; -- SUB RE RD RE  (Subtract RD from RE and store the results in RE)
08 : 0011000000001010; -- BRZ 0A        (Check if RE is zero)
09 : 0010000000000100; -- BRA 4         (if RE is 0 then branch to line 4)
0A : 0011110000000000; -- EXIT          (EXIT)
[0A..FF] : 1111111111111111;
END
